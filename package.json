{
  "name": "the-one-ring",
  "version": "0.12.5",
  "private": true,
  "license": "MIT",
  "engines": { "node": ">=24" },
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:config": "node --test tests/config.test.mjs tests/ui-consistency.test.mjs",
    "test:schema": "node --test tests/schema.test.mjs tests/sync-schema.test.mjs tests/online-schema.test.mjs tests/habit-schema.test.mjs",
    "test:history": "node --import tsx --test tests/history.test.ts tests/rotations.test.ts tests/backup.test.ts tests/routine-draft.test.ts tests/workout-ui.test.ts tests/sync-store.test.ts tests/workspace.test.ts tests/sync-integration.test.ts tests/online.test.ts tests/habits.test.ts tests/habit-online.test.ts tests/habit-insights.test.ts tests/demo.test.ts",
    "test:pwa": "node --test tests/pwa.test.mjs tests/pwa-update.test.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.109.0",
    "idb": "^8.0.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@playwright/test": "^1.65.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.7",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
